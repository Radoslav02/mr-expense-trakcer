# Copy this file to `.env` and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# `.env` is git-ignored. Never commit real values.
#
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# There, set VITE_FIREBASE_AUTH_DOMAIN to your Vercel domain (e.g. mr-expenses.vercel.app).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
