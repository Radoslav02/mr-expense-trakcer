rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // A user opts in to sharing by writing their partner's email on their own profile doc.
    function isPartnerOf(userId) {
      return hasEmail()
        && get(/databases/$(database)/documents/users/$(userId)).data.get('partnerEmail', '')
           == request.auth.token.email.lower();
    }

    // Both people shared with each other: the owner shared with me, and I shared back.
    function isConnectedTo(userId) {
      return isPartnerOf(userId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerEmail', '')
           == get(/databases/$(database)/documents/users/$(userId)).data.get('email', '').lower();
    }

    // A partner may change what an expense is, never where it lives or who owns it.
    function isPartnerEdit() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'amount', 'categoryId', 'date', 'note', 'paymentMethod', 'partnerShare',
          'updatedAt', 'editedBy'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.amount is number && data.amount > 0
        && data.partnerShare is number && data.partnerShare >= 0
        && data.partnerShare <= data.amount
        && data.date is timestamp
        && data.editedBy == request.auth.uid;
    }

    // A partner's app may copy shared categories into my list so both lists match, even when
    // my app is out of date. It can add or change one, never delete it or make it private.
    function isCategoryCopy(categoryId) {
      let data = request.resource.data;
      let fields = ['name', 'color', 'icon', 'sharedKey', 'deleted', 'updatedAt'];
      return data.name is string && data.name.size() > 0 && data.name.size() <= 32
        && data.color is string
        && data.sharedKey is string
        && data.deleted == false
        && (resource == null
          ? data.keys().hasOnly(fields.concat(['createdAt', 'isDefault']))
            && data.sharedKey == categoryId
          : data.diff(resource.data).affectedKeys().hasOnly(fields));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isPartnerOf(userId);

      // Everything under a user is owner-only by default: private expenses and categories,
      // recurring templates and the private finance doc (income).
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Only shared data is visible to the partner.
      match /categories/{categoryId} {
        allow read: if isPartnerOf(userId);
        allow create, update: if isConnectedTo(userId) && isCategoryCopy(categoryId);
      }

      match /expenses/{expenseId} {
        allow read: if isPartnerOf(userId);
        allow update: if isConnectedTo(userId) && isPartnerEdit();
      }

      // Shared savings; private ones live in privateSavings, which stays owner-only.
      match /savings/{savingId} {
        allow read: if isPartnerOf(userId);
      }
    }

    // Groups (trips with friends): joined app users are in memberIds; invited people are in
    // invitedEmails until they answer.
    match /groups/{groupId} {
      function isGroupMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isInvited() {
        return hasEmail() && request.auth.token.email.lower() in resource.data.invitedEmails;
      }

      // An invited person may only take their own invite: add themselves, drop their email and
      // touch at most one member entry (the one the invite created).
      function isAnsweringInvite() {
        let email = request.auth.token.email.lower();
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys()
            .hasOnly(['memberIds', 'invitedEmails', 'members', 'updatedAt'])
          && after.invitedEmails.toSet() == before.invitedEmails.toSet().difference([email].toSet())
          && after.memberIds.toSet().difference(before.memberIds.toSet())
            .hasOnly([request.auth.uid])
          && before.memberIds.toSet().difference(after.memberIds.toSet()).size() == 0
          && after.members.diff(before.members).affectedKeys().size() <= 1;
      }

      allow read: if isGroupMember() || isInvited();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if isGroupMember() || (isInvited() && isAnsweringInvite());
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Expenses and payments: any joined member may add, change or remove them.
      match /{collection}/{docId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    // Doc id = invitee's lowercased email. Tells the invitee which uid shared with them.
    match /partnerInvites/{email} {
      allow read: if (hasEmail() && request.auth.token.email.lower() == email)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
